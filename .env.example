# NOTE: this file only configures LOCAL dev. EAS Build uploads just the
# git-tracked files, so .env (gitignored) never reaches the build server, and
# EXPO_PUBLIC_* vars are inlined at build time. Cloud builds therefore read
# these from EAS, not from here. Register them once with:
#
#   npx.cmd eas-cli@latest env:create --name <NAME> --value <VALUE> \
#     --environment preview --visibility plaintext --scope project
#
# EXPO_PUBLIC_* values are baked into the client bundle and are extractable
# from any build. Never put a secret behind that prefix. A Test Store key is
# fine; a production RevenueCat secret key would not be.

# RevenueCat Test Store API key.
# Get yours at app.revenuecat.com -> Apps and providers -> Test Store.
# The Test Store runs a real purchase flow with NO paid Apple/Google developer
# account, which is what makes this entry eligible for the Next Gen award.
# Never ship a Test Store key to a real store listing.
EXPO_PUBLIC_RC_TEST_STORE_KEY=

# OneSignal App ID (Task 15). Optional - the app runs without it.
EXPO_PUBLIC_ONESIGNAL_APP_ID=
